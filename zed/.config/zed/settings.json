{
  "agent_servers": {
    "opencode": {
      "type": "custom",
      "command": "opencode",
      "args": [
        "acp"
      ],
      "env": {},
      "favorite_models": [],
      "default_config_options": {},
      "favorite_config_option_values": {},
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "relative_line_numbers": "enabled",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "project_panel": {
    "git_status": true,
    "dock": "right"
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/target",
    "**/build"
  ],
  "features": {
    "edit_prediction_provider": "supermaven"
  },
}
